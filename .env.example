# Firewalla MSP
MSP_DOMAIN=yourname.firewalla.net
MSP_TOKEN=paste-personal-access-token-here
# ID of the "block internet" rule for the phone (MSP > Rules > click rule > bottom of dialog)
# Format is <box-id>:<number>, e.g. 00000000-0000-0000-0000-000000000000:57
RULE_ID=00000000-0000-0000-0000-000000000000:0

# UI
DEVICE_LABEL=Phone
BEDTIME=21:00
TZ=America/Sao_Paulo

# Header Caddy injects with the signed-in user, used only for the audit log
USER_HEADER=X-Token-User-Email

# Address the container port is published on (see compose.yaml)
BIND_ADDR=127.0.0.1
